{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSiteObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3093/site/*"
    },
    {
      "Sid": "ListSitePrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cv-23l-3093",
      "Condition": {
        "StringEquals": { "s3:prefix": "site/" }
      }
    }
  ]
}
